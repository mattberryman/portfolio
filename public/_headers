/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' static.cloudflareinsights.com 'sha256-etvoftjwfNaNmy3tEXfz9NX71BMsPxBy9oY+saDKjYk='; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' cloudflareinsights.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# Fonts — long cache; files are stable and versioned by filename
/fonts/*
  Cache-Control: public, max-age=31536000

# Vite build output — filenames carry a content hash, so they never change in place
/assets/*
  Cache-Control: public, max-age=31536000, immutable
